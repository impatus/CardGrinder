<Window x:Class="CardGrinder.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CardGrinder" Width="1180" Height="820" MinWidth="940" MinHeight="680" WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}">
  <Grid Background="{StaticResource BackgroundBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="208" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Background="#151A20" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="22,28,22,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
          <Grid Height="39" HorizontalAlignment="Left" Margin="0,0,0,13" Width="42">
            <Border Width="25" Height="32" BorderBrush="#648B70" BorderThickness="2" CornerRadius="3" HorizontalAlignment="Left" VerticalAlignment="Top">
              <Border.RenderTransform>
                <RotateTransform Angle="-12" CenterX="12" CenterY="16" />
              </Border.RenderTransform>
            </Border>
            <Border Width="25" Height="32" Background="#202F27" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="3" HorizontalAlignment="Right" VerticalAlignment="Bottom">
              <TextBlock Text="♠" Foreground="{StaticResource AccentBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Grid>
          <TextBlock Text="CardGrinder" FontSize="21" FontWeight="SemiBold" />
          <TextBlock Text="A little less grind." Margin="0,5,0,0" Style="{StaticResource MutedText}" FontSize="12" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,40,0,0">
          <Border Background="#23322A" CornerRadius="5" Padding="12,12">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="▤" Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0" />
              <TextBlock Text="Card library" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
            </StackPanel>
          </Border>
          <Button Content="⚙   Settings" Command="{Binding SettingsCommand}" HorizontalContentAlignment="Left" Margin="0,7,0,0" Background="Transparent" BorderThickness="0" Padding="12,12" />
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,0,0,23">
          <TextBlock Text="FOCUSED BY DESIGN" FontSize="10" Foreground="#718090" FontWeight="SemiBold" />
          <TextBlock Text="Just your games.&#xA;Just your card drops." Margin="0,8,0,0" Foreground="#A7B3C0" FontSize="12" LineHeight="20" />
        </StackPanel>
        <StackPanel Grid.Row="4">
          <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,0">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="36" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" Background="#2C3642" CornerRadius="4">
                  <Grid>
                    <TextBlock Text="S" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{Binding AvatarUrl}" Stretch="UniformToFill" />
                  </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                  <TextBlock Text="{Binding ProfileName}" FontSize="12" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="Connected" Foreground="{StaticResource AccentBrush}" FontSize="11" Visibility="{Binding Connected, Converter={StaticResource BoolVisibility}}" />
                  <TextBlock Text="Offline" Style="{StaticResource MutedText}" FontSize="11" Visibility="{Binding Disconnected, Converter={StaticResource BoolVisibility}}" />
                </StackPanel>
              </Grid>
              <Button Content="Connect Steam" Command="{Binding ConnectCommand}" Margin="0,14,0,0" Style="{StaticResource PrimaryButton}" Visibility="{Binding Disconnected, Converter={StaticResource BoolVisibility}}" />
              <Button Content="New QR sign-in" Command="{Binding NewQrCommand}" Background="Transparent" BorderThickness="0" FontSize="11" Margin="0,4,0,0" Visibility="{Binding Disconnected, Converter={StaticResource BoolVisibility}}" />
              <Button Content="Sign out" Command="{Binding LogoutCommand}" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Padding="0,10,0,0" FontSize="11" Visibility="{Binding CanSignOut, Converter={StaticResource BoolVisibility}}" />
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding AppVersion}" FontSize="9" Foreground="#586675" Margin="0,18,0,0" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="30,26,30,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="YOUR COLLECTION, IN PROGRESS" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold" />
          <TextBlock Text="Card library" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,5" />
          <TextBlock Text="Find your remaining drops. Let the cards come to you." Style="{StaticResource MutedText}" />
        </StackPanel>
        <Button Grid.Column="1" Content="↻   Refresh library" Command="{Binding RefreshCommand}" VerticalAlignment="Center" Margin="12,0,0,0" />
      </Grid>
      <UniformGrid Grid.Row="1" Columns="3" Margin="0,24,0,20">
        <Border Background="{StaticResource PanelBrush}" CornerRadius="6" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="18,14" Margin="0,0,9,0">
          <StackPanel>
            <TextBlock Text="GAMES WITH DROPS" Style="{StaticResource MutedText}" FontSize="10" />
            <TextBlock Text="{Binding EligibleGames}" FontSize="29" FontWeight="SemiBold" Margin="0,3,0,0" />
          </StackPanel>
        </Border>
        <Border Background="{StaticResource PanelBrush}" CornerRadius="6" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="18,14" Margin="4,0,4,0">
          <StackPanel>
            <TextBlock Text="CARDS REMAINING" Style="{StaticResource MutedText}" FontSize="10" />
            <TextBlock Text="{Binding CardsRemaining}" FontSize="29" FontWeight="SemiBold" Margin="0,3,0,0" />
          </StackPanel>
        </Border>
        <Border Background="{StaticResource PanelBrush}" CornerRadius="6" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="18,14" Margin="9,0,0,0">
          <StackPanel>
            <TextBlock Text="RECEIVED THIS SESSION" Style="{StaticResource MutedText}" FontSize="10" />
            <TextBlock Text="{Binding CardsReceived}" Foreground="{StaticResource AccentBrush}" FontSize="29" FontWeight="SemiBold" Margin="0,3,0,0" />
          </StackPanel>
        </Border>
      </UniformGrid>
      <Border Grid.Row="2" Background="#1B3026" BorderBrush="#325741" BorderThickness="1" CornerRadius="6" Padding="16,13" Margin="0,0,0,18">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" />
              <TextBlock Text="{Binding StateLabel}" FontSize="10" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" Margin="0,6,16,0" FontSize="12" />
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Duration}" FontFamily="Cascadia Mono, Consolas" FontSize="20" HorizontalAlignment="Right" />
            <TextBlock Text="ACTIVE TIME" FontSize="9" Foreground="#7F9E8B" HorizontalAlignment="Right" Margin="0,4,0,0" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Row="3" Background="#352826" BorderBrush="#6C4940" BorderThickness="1" CornerRadius="5" Padding="12,9" Margin="0,0,0,14" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Error}" Foreground="#F0C6B6" FontSize="12" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="×" Command="{Binding DismissErrorCommand}" Background="Transparent" BorderThickness="0" Padding="10,0" Margin="8,0,0,0" AutomationProperties.Name="Dismiss error" />
        </Grid>
      </Border>
      <Grid Grid.Row="4" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="168" />
        </Grid.ColumnDefinitions>
        <CheckBox Content="Select all" IsChecked="{Binding AllVisibleGamesSelected, Mode=OneWay}" Command="{Binding SelectAllCommand}" IsEnabled="{Binding CanSelectAll}" Margin="0,0,14,0" FontSize="11" ToolTip="Select or clear all games with drops in the current view." AutomationProperties.Name="Select all games" />
        <Grid Grid.Column="1">
          <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search games" Padding="30,9,10,9" />
          <TextBlock Text="⌕" Foreground="#7B8B9C" FontSize="19" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
          <TextBlock Text="Search games or AppID" Foreground="#6D7D8E" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Search}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
        <CheckBox Grid.Column="2" Content="Show completed" IsChecked="{Binding ShowCompleted}" Margin="16,0" FontSize="11" />
        <ComboBox Grid.Column="3" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Sort}" AutomationProperties.Name="Sort games" />
      </Grid>
      <Border Grid.Row="5" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Background="#14191F">
        <Grid>
          <ListBox x:Name="GameList" ItemsSource="{Binding GamesView}" Foreground="{StaticResource TextBrush}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" HorizontalContentAlignment="Stretch" Padding="0">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Row" Background="Transparent">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Row" Property="Background" Value="#1E2630" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="#252D36" BorderThickness="0,0,0,1" Padding="14,15">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="28" />
                      <ColumnDefinition Width="116" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="76" />
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" />
                    <Border Grid.Column="1" Height="54" Background="#26313C" CornerRadius="3" ClipToBounds="True">
                      <Grid>
                        <TextBlock Text="♠" Foreground="#4A5E70" FontSize="27" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <Image Source="{Binding CoverUrl}" Stretch="UniformToFill" />
                      </Grid>
                    </Border>
                    <Grid Grid.Column="2" Margin="16,0,16,0">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Row="1" Text="{Binding Details}" Style="{StaticResource MutedText}" FontSize="10" Margin="0,3,0,7" />
                      <ProgressBar Grid.Row="2" Value="{Binding Percent, Mode=OneWay}" Maximum="100" />
                      <TextBlock Grid.Row="3" Text="{Binding ProgressText}" Foreground="#77899B" FontSize="10" Margin="0,5,0,0" />
                    </Grid>
                    <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Remaining, StringFormat={}{0} left}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                      <TextBlock Text="{Binding Status}" FontSize="10" Margin="0,5,0,0" HorizontalAlignment="Right">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#93A3B5" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Active}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="410" Margin="22" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="64" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="46" Height="50" Background="#213129" CornerRadius="7" HorizontalAlignment="Left" VerticalAlignment="Center">
              <TextBlock Text="♠" Foreground="{StaticResource AccentBrush}" FontSize="29" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1">
              <TextBlock Text="{Binding EmptyTitle}" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="{Binding EmptyDescription}" Style="{StaticResource MutedText}" Margin="0,9,0,0" LineHeight="21" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
      <StackPanel Grid.Row="6" Margin="0,14,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding SelectionText}" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Content="Pause" Command="{Binding PauseCommand}" Padding="12,8" Margin="0,0,6,0" />
            <Button Content="Resume" Command="{Binding ResumeCommand}" Padding="12,8" Margin="0,0,6,0" />
            <Button Content="Stop" Command="{Binding StopCommand}" Padding="12,8" Margin="0,0,6,0" />
            <Button Content="▶   Start farming" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" Padding="16,8" />
          </StackPanel>
        </Grid>
        <CheckBox Content="Farm selected games simultaneously" IsChecked="{Binding Together}" FontSize="11" Margin="0,12,0,0" />
        <TextBlock Text="Simultaneous farming can reduce drop efficiency. One game at a time is recommended." Foreground="#C6AD78" FontSize="10" Margin="0,6,0,0" Visibility="{Binding Together, Converter={StaticResource BoolVisibility}}" />
        <Grid Margin="0,13,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding LastUpdated}" Foreground="#6C7C8E" FontSize="10" />
          <TextBlock Grid.Column="1" Text="Confirmed drops. No estimated timers." Foreground="#6C7C8E" FontSize="10" Margin="12,0,0,0" />
        </Grid>
        <ProgressBar IsIndeterminate="True" Height="2" Margin="0,10,0,0" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}" />
      </StackPanel>
    </Grid>
    <Border Grid.ColumnSpan="2" Background="#D9101317" Visibility="{Binding SettingsOpen, Converter={StaticResource BoolVisibility}}">
      <Border Width="520" MaxHeight="620" Margin="0,20" Padding="30" CornerRadius="8" Background="#1A2129" BorderBrush="#35404D" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Grid>
              <TextBlock Text="Settings" FontSize="25" FontWeight="SemiBold" />
              <Button Content="×" Command="{Binding SettingsCommand}" HorizontalAlignment="Right" Padding="9,2" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Close settings" />
            </Grid>
            <TextBlock Text="Small preferences. Nothing extra." Style="{StaticResource MutedText}" Margin="0,8,0,23" />
            <CheckBox Content="Start minimized" IsChecked="{Binding StartMinimized}" Margin="0,10" />
            <CheckBox Content="Minimize to system tray" IsChecked="{Binding MinimizeToTray}" Margin="0,10" />
            <CheckBox Content="Automatically advance the farming queue" IsChecked="{Binding AutomaticQueue}" Margin="0,10" />
            <CheckBox Content="Allow waiting for eligible playtime" IsChecked="{Binding WaitForEligiblePlaytime}" Margin="0,10" />
            <TextBlock Text="If disabled, selections with games under 2 hours of playtime cannot start. Steam determines actual drop eligibility; no minimum can be guaranteed." FontSize="11" Style="{StaticResource MutedText}" Margin="22,0,0,20" LineHeight="18" />
            <Border BorderBrush="#35404D" BorderThickness="0,1,0,0" Padding="0,16,0,18" DataContext="{Binding Updates}">
              <StackPanel>
                <TextBlock Text="Updates" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="{Binding CurrentVersion}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,10" />
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" LineHeight="18" />
                <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                  <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" Style="{StaticResource MutedText}" FontSize="11" />
                </ScrollViewer>
                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="3" Margin="0,9,0,0" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}" />
                <WrapPanel Margin="0,12,0,0">
                  <Button Content="Check for updates" Command="{Binding CheckCommand}" Padding="12,7" Margin="0,0,6,6" />
                  <Button Content="Download update" Command="{Binding DownloadCommand}" Padding="12,7" Margin="0,0,6,6" Visibility="{Binding Available, Converter={StaticResource BoolVisibility}}" />
                  <Button Content="{Binding InstallLabel}" Command="{Binding InstallCommand}" Style="{StaticResource PrimaryButton}" Padding="12,7" Margin="0,0,6,6" Visibility="{Binding Ready, Converter={StaticResource BoolVisibility}}" />
                  <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="12,7" Margin="0,0,0,6" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}" />
                </WrapPanel>
                <TextBlock Text="Checks are manual. Downloads are signature-verified. Windows may still show an unknown publisher warning." Style="{StaticResource MutedText}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
              </StackPanel>
            </Border>
            <Border BorderBrush="#35404D" BorderThickness="0,1,0,0" Padding="0,18,0,0">
              <TextBlock Text="CardGrinder uses a separate Steam connection. Third-party automation is not guaranteed to be permitted by Valve and is not risk-free." FontSize="11" Foreground="#B6AE96" LineHeight="19" />
            </Border>
            <Button Content="Done" Command="{Binding SettingsCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,23,0,0" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Border>
    <Border Grid.ColumnSpan="2" Background="#ED101317" Visibility="{Binding SigningIn, Converter={StaticResource BoolVisibility}}">
      <Border Width="420" Padding="30" CornerRadius="8" Background="#1A2129" BorderBrush="#35404D" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel>
          <TextBlock Text="Connect to Steam" FontSize="25" FontWeight="SemiBold" TextAlignment="Center" />
          <TextBlock Text="Open Steam on your phone. Scan, then approve." TextAlignment="Center" Style="{StaticResource MutedText}" Margin="0,10,0,22" />
          <Border Width="232" Height="232" Background="#FFFFFF" CornerRadius="6" Padding="8" HorizontalAlignment="Center">
            <Grid>
              <TextBlock Text="Preparing secure sign-in…" Foreground="#33443B" TextAlignment="Center" VerticalAlignment="Center" />
              <Image Source="{Binding QrImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" Visibility="{Binding HasQr, Converter={StaticResource BoolVisibility}}" />
            </Grid>
          </Border>
          <TextBlock Text="{Binding Connection}" Style="{StaticResource MutedText}" FontSize="12" TextAlignment="Center" Margin="0,22,0,0" />
          <TextBlock Text="Your password never enters CardGrinder. The saved session is encrypted for your Windows account." FontSize="11" TextAlignment="Center" Foreground="#748797" Margin="0,14,0,20" />
          <Button Content="Cancel" Command="{Binding CancelSignInCommand}" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
